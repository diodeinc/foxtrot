#!/usr/bin/env bash
set -euo pipefail

# The corpus runner needs Python 3.10+ (provided by the orb) and native Rust.
if ! command -v cargo >/dev/null && [[ ! -x "$HOME/.cargo/bin/cargo" ]]; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
fi
if [[ -f "$HOME/.cargo/env" ]]; then
    source "$HOME/.cargo/env"
fi
cargo --version
python3 --version
# OCCT is optional and intentionally not installed for every orb.
